<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.qoder.claim</groupId>
        <artifactId>claim-pro</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>claim-gateway</artifactId>
    <name>claim-gateway</name>
    <dependencies>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-agents</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qoder.claim</groupId>
            <artifactId>claim-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>claim-pro</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>